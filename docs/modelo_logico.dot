digraph modelo_logico {
  graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.6, concentrate=false, fontname="Helvetica", label="Maximo das Tintas - Modelo Logico (MySQL 8 - banco loja_tintas_materiais)", labelloc=t, fontsize=20];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=11, color="#555555", arrowsize=0.8];
  categoria [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E8F1FB"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>categoria</b></font></td></tr><tr><td align="left" port="id_categoria_in">PK</td><td align="left"><b>id_categoria</b></td><td align="left" port="id_categoria_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="nome_categoria_in">UQ</td><td align="left">nome_categoria</td><td align="left" port="nome_categoria_out"><font color="#555555">varchar(60) NN</font></td></tr><tr><td align="left" port="descricao_in"></td><td align="left">descricao</td><td align="left" port="descricao_out"><font color="#555555">varchar(200)</font></td></tr></table>>];
  fornecedor [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E8F1FB"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>fornecedor</b></font></td></tr><tr><td align="left" port="id_fornecedor_in">PK</td><td align="left"><b>id_fornecedor</b></td><td align="left" port="id_fornecedor_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="nome_fornecedor_in"></td><td align="left">nome_fornecedor</td><td align="left" port="nome_fornecedor_out"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="cnpj_in">UQ</td><td align="left">cnpj</td><td align="left" port="cnpj_out"><font color="#555555">char(14) NN</font></td></tr><tr><td align="left" port="telefone_in"></td><td align="left">telefone</td><td align="left" port="telefone_out"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="email_in"></td><td align="left">email</td><td align="left" port="email_out"><font color="#555555">varchar(100)</font></td></tr></table>>];
  produto [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E8F1FB"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>produto</b></font></td></tr><tr><td align="left" port="id_produto_in">PK</td><td align="left"><b>id_produto</b></td><td align="left" port="id_produto_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="codigo_interno_in">UQ</td><td align="left">codigo_interno</td><td align="left" port="codigo_interno_out"><font color="#555555">varchar(20) NN</font></td></tr><tr><td align="left" port="codigo_barras_in"></td><td align="left">codigo_barras</td><td align="left" port="codigo_barras_out"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="descricao_in"></td><td align="left">descricao</td><td align="left" port="descricao_out"><font color="#555555">varchar(150) NN</font></td></tr><tr><td align="left" port="ncm_in"></td><td align="left">ncm</td><td align="left" port="ncm_out"><font color="#555555">varchar(10)</font></td></tr><tr><td align="left" port="unidade_medida_in"></td><td align="left">unidade_medida</td><td align="left" port="unidade_medida_out"><font color="#555555">varchar(5) NN</font></td></tr><tr><td align="left" port="preco_unitario_in"></td><td align="left">preco_unitario</td><td align="left" port="preco_unitario_out"><font color="#555555">decimal(10,2) NN</font></td></tr><tr><td align="left" port="preco_custo_in"></td><td align="left">preco_custo</td><td align="left" port="preco_custo_out"><font color="#555555">decimal(10,2)</font></td></tr><tr><td align="left" port="id_categoria_in">FK</td><td align="left"><i>id_categoria</i></td><td align="left" port="id_categoria_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_fornecedor_in">FK</td><td align="left"><i>id_fornecedor</i></td><td align="left" port="id_fornecedor_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="ativo_in"></td><td align="left">ativo</td><td align="left" port="ativo_out"><font color="#555555">tinyint(1) NN</font></td></tr></table>>];
  estoque [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E8F1FB"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>estoque</b></font></td></tr><tr><td align="left" port="id_estoque_in">PK</td><td align="left"><b>id_estoque</b></td><td align="left" port="id_estoque_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_produto_in">FK UQ</td><td align="left"><i>id_produto</i></td><td align="left" port="id_produto_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="quantidade_atual_in"></td><td align="left">quantidade_atual</td><td align="left" port="quantidade_atual_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="quantidade_minima_in"></td><td align="left">quantidade_minima</td><td align="left" port="quantidade_minima_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="localizacao_deposito_in"></td><td align="left">localizacao_deposito</td><td align="left" port="localizacao_deposito_out"><font color="#555555">varchar(50)</font></td></tr></table>>];
  cliente [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EEF7EE"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>cliente</b></font></td></tr><tr><td align="left" port="id_cliente_in">PK</td><td align="left"><b>id_cliente</b></td><td align="left" port="id_cliente_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="nome_in"></td><td align="left">nome</td><td align="left" port="nome_out"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="tipo_pessoa_in"></td><td align="left">tipo_pessoa</td><td align="left" port="tipo_pessoa_out"><font color="#555555">enum(&#x27;PF&#x27;,&#x27;PJ&#x27;) NN</font></td></tr><tr><td align="left" port="cpf_cnpj_in">UQ</td><td align="left">cpf_cnpj</td><td align="left" port="cpf_cnpj_out"><font color="#555555">varchar(14) NN</font></td></tr><tr><td align="left" port="telefone_in"></td><td align="left">telefone</td><td align="left" port="telefone_out"><font color="#555555">varchar(20)</font></td></tr><tr><td align="left" port="email_in"></td><td align="left">email</td><td align="left" port="email_out"><font color="#555555">varchar(100)</font></td></tr><tr><td align="left" port="endereco_in"></td><td align="left">endereco</td><td align="left" port="endereco_out"><font color="#555555">varchar(150)</font></td></tr><tr><td align="left" port="data_cadastro_in"></td><td align="left">data_cadastro</td><td align="left" port="data_cadastro_out"><font color="#555555">date NN</font></td></tr></table>>];
  funcionario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EEF7EE"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>funcionario</b></font></td></tr><tr><td align="left" port="id_funcionario_in">PK</td><td align="left"><b>id_funcionario</b></td><td align="left" port="id_funcionario_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="nome_in"></td><td align="left">nome</td><td align="left" port="nome_out"><font color="#555555">varchar(100) NN</font></td></tr><tr><td align="left" port="cargo_in"></td><td align="left">cargo</td><td align="left" port="cargo_out"><font color="#555555">varchar(50) NN</font></td></tr><tr><td align="left" port="cpf_in">UQ</td><td align="left">cpf</td><td align="left" port="cpf_out"><font color="#555555">char(11) NN</font></td></tr><tr><td align="left" port="data_admissao_in"></td><td align="left">data_admissao</td><td align="left" port="data_admissao_out"><font color="#555555">date NN</font></td></tr><tr><td align="left" port="ativo_in"></td><td align="left">ativo</td><td align="left" port="ativo_out"><font color="#555555">tinyint(1) NN</font></td></tr></table>>];
  venda [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FDF1E6"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>venda</b></font></td></tr><tr><td align="left" port="id_venda_in">PK</td><td align="left"><b>id_venda</b></td><td align="left" port="id_venda_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_cliente_in">FK</td><td align="left"><i>id_cliente</i></td><td align="left" port="id_cliente_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_funcionario_in">FK</td><td align="left"><i>id_funcionario</i></td><td align="left" port="id_funcionario_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="data_venda_in"></td><td align="left">data_venda</td><td align="left" port="data_venda_out"><font color="#555555">datetime NN</font></td></tr><tr><td align="left" port="status_venda_in"></td><td align="left">status_venda</td><td align="left" port="status_venda_out"><font color="#555555">enum(&#x27;ORCAMENTO&#x27;,&#x27;CONCLUIDA&#x27;,&#x27;CANCELADA&#x27;) NN</font></td></tr><tr><td align="left" port="valor_desconto_in"></td><td align="left">valor_desconto</td><td align="left" port="valor_desconto_out"><font color="#555555">decimal(10,2) NN</font></td></tr><tr><td align="left" port="valor_total_in"></td><td align="left">valor_total</td><td align="left" port="valor_total_out"><font color="#555555">decimal(10,2) NN</font></td></tr></table>>];
  item_venda [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FDF1E6"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>item_venda</b></font></td></tr><tr><td align="left" port="id_item_venda_in">PK</td><td align="left"><b>id_item_venda</b></td><td align="left" port="id_item_venda_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_venda_in">FK</td><td align="left"><i>id_venda</i></td><td align="left" port="id_venda_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_produto_in">FK</td><td align="left"><i>id_produto</i></td><td align="left" port="id_produto_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="quantidade_in"></td><td align="left">quantidade</td><td align="left" port="quantidade_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="preco_unitario_venda_in"></td><td align="left">preco_unitario_venda</td><td align="left" port="preco_unitario_venda_out"><font color="#555555">decimal(10,2) NN</font></td></tr><tr><td align="left" port="subtotal_in"></td><td align="left">subtotal</td><td align="left" port="subtotal_out"><font color="#555555">decimal(10,2)</font></td></tr></table>>];
  pagamento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FDF1E6"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>pagamento</b></font></td></tr><tr><td align="left" port="id_pagamento_in">PK</td><td align="left"><b>id_pagamento</b></td><td align="left" port="id_pagamento_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_venda_in">FK</td><td align="left"><i>id_venda</i></td><td align="left" port="id_venda_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="forma_pagamento_in"></td><td align="left">forma_pagamento</td><td align="left" port="forma_pagamento_out"><font color="#555555">enum(&#x27;DINHEIRO&#x27;,&#x27;PIX&#x27;,&#x27;CARTAO_CREDITO&#x27;,&#x27;CARTAO_DEBITO&#x27;,&#x27;BOLETO&#x27;) NN</font></td></tr><tr><td align="left" port="valor_pago_in"></td><td align="left">valor_pago</td><td align="left" port="valor_pago_out"><font color="#555555">decimal(10,2) NN</font></td></tr><tr><td align="left" port="data_pagamento_in"></td><td align="left">data_pagamento</td><td align="left" port="data_pagamento_out"><font color="#555555">datetime NN</font></td></tr><tr><td align="left" port="parcelas_in"></td><td align="left">parcelas</td><td align="left" port="parcelas_out"><font color="#555555">int NN</font></td></tr></table>>];
  historico_preco [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#E8F1FB"><tr><td colspan="3" bgcolor="#5B2C83"><font color="white"><b>historico_preco</b></font></td></tr><tr><td align="left" port="id_historico_in">PK</td><td align="left"><b>id_historico</b></td><td align="left" port="id_historico_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="id_produto_in">FK</td><td align="left"><i>id_produto</i></td><td align="left" port="id_produto_out"><font color="#555555">int NN</font></td></tr><tr><td align="left" port="preco_anterior_in"></td><td align="left">preco_anterior</td><td align="left" port="preco_anterior_out"><font color="#555555">decimal(10,2) NN</font></td></tr><tr><td align="left" port="preco_novo_in"></td><td align="left">preco_novo</td><td align="left" port="preco_novo_out"><font color="#555555">decimal(10,2) NN</font></td></tr><tr><td align="left" port="data_alteracao_in"></td><td align="left">data_alteracao</td><td align="left" port="data_alteracao_out"><font color="#555555">datetime NN</font></td></tr></table>>];
  produto:id_produto_out:e -> estoque:id_produto_in:w [dir=both, arrowtail=teetee, arrowhead=teetee, taillabel="(1,1)", headlabel="(1,1)", labeldistance=2.2, labelangle=25];
  produto:id_produto_out:e -> historico_preco:id_produto_in:w [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", labeldistance=2.2, labelangle=25];
  produto:id_produto_out:e -> item_venda:id_produto_in:w [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", labeldistance=2.2, labelangle=25];
  venda:id_venda_out:e -> item_venda:id_venda_in:w [dir=both, arrowtail=teetee, arrowhead=crowtee, taillabel="(1,1)", headlabel="(1,N)", labeldistance=2.2, labelangle=25];
  venda:id_venda_out:e -> pagamento:id_venda_in:w [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", labeldistance=2.2, labelangle=25];
  categoria:id_categoria_out:e -> produto:id_categoria_in:w [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", labeldistance=2.2, labelangle=25];
  fornecedor:id_fornecedor_out:e -> produto:id_fornecedor_in:w [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", labeldistance=2.2, labelangle=25];
  cliente:id_cliente_out:e -> venda:id_cliente_in:w [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", labeldistance=2.2, labelangle=25];
  funcionario:id_funcionario_out:e -> venda:id_funcionario_in:w [dir=both, arrowtail=teetee, arrowhead=crowodot, taillabel="(1,1)", headlabel="(0,N)", labeldistance=2.2, labelangle=25];
}
