// Maximo das Tintas - Fluxo de venda no balcao
// Gerar: dot -Tpng -Gdpi=130 fluxo_vendas.dot -o fluxo_vendas.png
digraph fluxo_vendas {
  graph [rankdir=TB, fontname="Helvetica", label="Maximo das Tintas - Fluxo de venda no balcao", labelloc=t, fontsize=18, nodesep=0.5, ranksep=0.45];
  node  [fontname="Helvetica", fontsize=11, style="rounded,filled", fillcolor="#F3EDF8", color="#5B2C83", shape=box];
  edge  [fontname="Helvetica", fontsize=10, color="#555555"];

  inicio   [label="Cliente chega ao balcao", shape=oval, fillcolor="#5B2C83", fontcolor="white"];
  cad      [label="Cliente ja cadastrado?", shape=diamond, style=filled, fillcolor="#FFF6D6"];
  novo     [label="Cadastrar cliente (PF/PJ)\nINSERT cliente"];
  abre     [label="Funcionario abre a venda\nINSERT venda (cliente + funcionario)"];
  itens    [label="Lancar produtos e quantidades\nINSERT item_venda (preco do momento)"];
  ativo    [label="Produto ativo e\ncom estoque?", shape=diamond, style=filled, fillcolor="#FFF6D6"];
  outro    [label="Oferecer similar /\nanotar para reposicao"];
  decide   [label="Cliente fecha agora?", shape=diamond, style=filled, fillcolor="#FFF6D6"];
  orc      [label="Fica como ORCAMENTO\n(sem baixa de estoque)"];
  conclui  [label="Venda CONCLUIDA"];
  baixa    [label="Trigger baixa o estoque\nde todos os itens", fillcolor="#E6F2E6", color="#2E7D32"];
  pag      [label="Registrar pagamento(s)\nDinheiro, PIX, cartao, boleto\nINSERT pagamento"];
  fim      [label="Entrega da mercadoria", shape=oval, fillcolor="#5B2C83", fontcolor="white"];
  troca    [label="Troca / desistencia\n(ate 2 semanas, com nota)", shape=box, fillcolor="#FDECEC", color="#C62828"];
  cancela  [label="Venda CANCELADA\n(historico preservado)", fillcolor="#FDECEC", color="#C62828"];
  devolve  [label="Trigger devolve o estoque", fillcolor="#E6F2E6", color="#2E7D32"];

  inicio -> cad;
  cad -> abre  [label="sim"];
  cad -> novo  [label="nao"];
  novo -> abre;
  abre -> itens -> ativo;
  ativo -> decide [label="sim"];
  ativo -> outro  [label="nao"];
  outro -> itens  [style=dashed];
  decide -> orc     [label="nao"];
  decide -> conclui [label="sim"];
  orc -> conclui    [label="cliente volta e confirma", style=dashed];
  conclui -> baixa -> pag -> fim;
  fim -> troca   [style=dashed];
  troca -> cancela -> devolve;
}
